<Project>

  <!--
    What an addon install is given after it was built, which is the half of a singleton Godot makes rather than the
    compiler: the node the engine made is not known to the field until a notification tells it, and the notification
    cannot be generated beside the one a type may have written, so it is woven into the assembly afterwards.

    What Godot does not know about is the entry which makes the engine send that notification at all - the generator of
    the engine decides which overridable methods a script class answers for from the files it is handed, and a method
    added to the assembly afterwards is one it never saw. So the weaver writes the entry as well, which is why it runs
    on the built assembly rather than being a part of the compilation.

    This file is read from the Directory.Build.props which the plugin writes at the root of the project.
  -->

  <PropertyGroup>
    <SingletonGodotWeaver>$(MSBuildThisFileDirectory)Singleton.Weaver.dll</SingletonGodotWeaver>
  </PropertyGroup>

  <Target Name="SingletonGodotWeave"
          AfterTargets="Build"
          Condition="'$(SingletonGodotDisable)' != 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(TargetPath)')">

    <Error Condition="!Exists('$(SingletonGodotWeaver)')"
           Text="The Singleton weaver is not where the addon puts it ('$(SingletonGodotWeaver)'), so the singletons of this project cannot be woven." />

    <!-- A status which is not zero stops the build with what went wrong printed. A singleton which is not woven is one
         whose nodes never reach the field, which reads as a singleton that is made twice rather than as a build which
         failed, so this is not something to carry on past. -->
    <Exec Command="dotnet &quot;$(SingletonGodotWeaver)&quot; &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
