<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>13</LangVersion>
        <RootNamespace>Singleton.Generator</RootNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup>
        <UnityPluginDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Plugins'))</UnityPluginDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.9.0" />
    </ItemGroup>

    <Target Name="CopyToUnityPlugin" AfterTargets="Build"
            Condition="'$(CopyWeaverToUnity)' == 'true' And '$(TargetFramework)' == 'netstandard2.1'"
            Inputs="$(TargetPath);$(TargetDir)$(TargetName).pdb"
            Outputs="$(UnityPluginDirectory)\$(TargetName).dll;$(UnityPluginDirectory)\$(TargetName).pdb">
        <ItemGroup>
            <UnityPluginAssembly Include="$(TargetPath)"/>
            <UnityPluginAssembly Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
        </ItemGroup>
        <Copy SourceFiles="@(UnityPluginAssembly)" DestinationFolder="$(UnityPluginDirectory)" SkipUnchangedFiles="true"/>
        <Message Text="Copy to Unity plugin: %(UnityPluginAssembly.Filename)%(UnityPluginAssembly.Extension) ($(Configuration))" Importance="high"/>
    </Target>
</Project>